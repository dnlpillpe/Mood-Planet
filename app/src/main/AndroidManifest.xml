<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        RECORD_AUDIO se solicita SOLO cuando el niño abre el ejercicio opcional
        "Mi voz tranquila". No se usa para reconocimiento de voz ni se sube a
        ningún servidor: solo se analiza el nivel de volumen en memoria (PCM)
        y se descarta inmediatamente. Ver docs/PRIVACIDAD.md.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".MoodPlanetApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoodPlanet"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!--
            Mood Planet es una aplicación 100% offline: no declara permisos de
            INTERNET. El bloque networkSecurityConfig/usesCleartextTraffic se
            deja como defensa en profundidad por si en el futuro se añadiera
            alguna librería que intente red, pero hoy no hay tráfico alguno.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MoodPlanet"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
